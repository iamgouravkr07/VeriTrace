# LLM Provider Selection: "gemini" (default) or "grok"
LLM_PROVIDER=gemini

# Optional Fallback Provider: e.g. "gemini" when LLM_PROVIDER=grok, or empty for no fallback
LLM_FALLBACK_PROVIDER=

# Gemini LLM Settings
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Grok / xAI LLM Settings
XAI_API_KEY=""
XAI_BASE_URL="https://api.x.ai/v1"
GROK_MODEL="grok-4.7"

# Shared LLM Settings
LLM_TIMEOUT_SECONDS=30.0
LLM_TEMPERATURE=0.0

# Demo Mode Default
DEMO_MODE_DEFAULT=false

# Scoring Weights
WEIGHT_NLI=0.5
WEIGHT_RETRIEVAL=0.3
WEIGHT_SOURCE=0.2

# Risk Thresholds
THRESHOLD_LOW_MAX=20.0
THRESHOLD_MEDIUM_MAX=50.0
THRESHOLD_HIGH_MAX=80.0
